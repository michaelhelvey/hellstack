{
  "name": "@michaelhelvey/hellstack2",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@earendil-works/pi-coding-agent": "1.5.0",
      "@earendil-works/pi-tui": "1.5.0",
      "@effect/platform-bun": "4.1.2",
      "effect": "4.1.2",
      "@opentui/core": "0.8.3",
      "@opentui/solid": "0.8.3",
      "marked": "18.0.11",
      "solid-js": "1.9.18",
      "typebox": "1.3.27",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --oxlint",
    "pi": "bun scripts/pi.ts",
    "setup": "bun packages/agent/src/setup.ts",
    "build": "bun packages/pi/src/build.ts",
    "whatsgoingon": "bun --preload ./packages/dash/src/preload.ts packages/dash/src/main.tsx",
    "format": "vp fmt",
    "lint": "vp lint --fix",
    "check": "vp check",
    "validate": "bun run format && bun run lint && bun run check && bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@michaelhelvey/vite-config": "2.0.8",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "vite-plus": "^1.5.0"
  }
}
