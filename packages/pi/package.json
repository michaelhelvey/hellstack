{
  "name": "@hellstack/pi",
  "version": "0.0.0",
  "description": "Personal pi extensions and themes.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/*/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "dependencies": {
    "@hellstack/sync": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  }
}
