{
  "name": "@hellstack/pi",
  "version": "0.0.0",
  "description": "Personal pi extensions.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/*/index.ts"
    ]
  },
  "dependencies": {
    "marked": "18.0.11",
    "zod": "catalog:",
    "@hellstack/prompts": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0"
  }
}
