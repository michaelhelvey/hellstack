{
  "id": "root",
  "type": "column",
  "background": "background",
  "terminal_padding": [0, 0],
  "preview": "layouts/tmux.svg",
  "children": [
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "hidden": true,
          "size": {
            "px": 240
          },
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 0,
              "radius": 0,
              "border": {
                "width": 0,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              },
              "lone": false
            }
          }
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 28
      },
      "content": {
        "mod": "tmux-status"
      }
    }
  ]
}
